[Unit]
Description=Mobile exercise tracker private web service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/mobile-exercise-tracker
Environment=TRACKER_API_HOST=127.0.0.1
ExecStart=/usr/bin/python3 %h/Projects/mobile-exercise-tracker/scripts/tracker-api.py 5175
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

